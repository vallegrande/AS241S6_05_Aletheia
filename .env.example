# Firebase Auth (Google) — copia este archivo a .env y completa tus valores
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Contrato ProofRegistry en Polygon Amoy (docs/REMIX.md). Vacío = on-chain deshabilitado.
VITE_PROOF_REGISTRY_ADDRESS=

# LinkedIn (conectar identidad desde el perfil). Debe coincidir EXACTO con
# la "Authorized redirect URL" registrada en el LinkedIn Developer Portal.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Vacío = http://localhost:3001/api/profile/linkedin/callback
LINKEDIN_REDIRECT_URI=
